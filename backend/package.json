{
  "name": "homeiq-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "snowflake:test": "node --env-file-if-exists=.env src/scripts/test-snowflake.ts",
    "snowflake:seed-devices": "node --env-file-if-exists=.env src/scripts/seed-devices.ts",
    "snowflake:seed-history": "node --env-file-if-exists=.env src/scripts/seed-history.ts",
    "gemini:test": "node --env-file-if-exists=.env src/scripts/test-gemini.ts"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "express": "^5.2.1",
    "snowflake-sdk": "^3.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/snowflake-sdk": "^1.6.24",
    "typescript": "^6.0.3"
  }
}
